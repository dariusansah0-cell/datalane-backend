# Copy this file to .env and fill in real values. Never commit the real .env file.

# --- Server ---
PORT=4000
# The URL your frontend is hosted at, so the backend allows it to make requests (CORS).
FRONTEND_URL=https://your-site.example.com

# --- Database (MongoDB Atlas free tier — atlas.mongodb.com) ---
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/datalane

# --- Paystack (dashboard.paystack.com → Settings → API Keys) ---
# This is the SECRET key — starts with sk_live_ or sk_test_. Keep this on the server only.
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Admin login for the admin dashboard ---
ADMIN_PASSWORD=choose-a-strong-password
JWT_SECRET=choose-a-long-random-string

# --- SMS via Arkesel (arkesel.com — Ghana-based, easiest to register with GHS payment) ---
ARKESEL_API_KEY=your-arkesel-api-key
ARKESEL_SENDER_ID=DataLane
